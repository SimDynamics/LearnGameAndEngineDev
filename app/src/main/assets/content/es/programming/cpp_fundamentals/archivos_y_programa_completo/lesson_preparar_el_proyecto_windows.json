                },
                {
                  "id": "repeticion",
                  "label": "Otra persona sigue las instrucciones de preparación, construcción y pruebas y reproduce los resultados indicados en el entorno descrito."
                },
                {
                  "id": "conceptos",
                  "label": "Resuelves las preguntas sobre herramientas dentro de la app sin instalar, configurar ni ejecutar el proyecto externo."
                }
              ],
              "targets": [
                {
