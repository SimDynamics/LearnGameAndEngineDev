        {
          "type": "code",
          "language": "cpp",
          "code": "#include <iostream>\n#include <vector>\n\nbool datos_validos(const std::vector<int>& niveles) {\n    if (niveles.size() > 8) {\n        return false;\n    }\n    for (int nivel : niveles) {\n        if ((nivel < -10) || (nivel > 10)) {\n            return false;\n        }\n    }\n    return true;\n}\n\nint limitar_nivel(int nivel) {\n    if (nivel < 0) {\n        return 0;\n    }\n    if (nivel > 4) {\n        return 4;\n    }\n    return nivel;\n}\n\nvoid normalizar(std::vector<int>& niveles) {\n    for (int& nivel : niveles) {\n        nivel = limitar_nivel(nivel);\n    }\n}\n\nint contar_al_limite(const std::vector<int>& niveles) {\n    int cuenta = 0;\n    for (int nivel : niveles) {\n        if (nivel == 4) {\n            ++cuenta;\n        }\n    }\n    return cuenta;\n}\n\nint main() {\n    std::vector<int> niveles;\n    int cantidad_entrada{0};\n    std::cin >> cantidad_entrada;\n    for (int entrada{0}; entrada < cantidad_entrada; ++entrada) {\n        int dato{0};\n        std::cin >> dato;\n        niveles.push_back(dato);\n    }\n\n    if (!datos_validos(niveles)) {\n        std::cout << \"Lecturas invalidas\";\n    } else {\n        normalizar(niveles);\n        const int al_limite = contar_al_limite(niveles);\n        std::cout << \"Niveles:\";\n        for (int nivel : niveles) {\n            std::cout << \" \" << nivel;\n        }\n        std::cout << \"\\nAl limite: \" << al_limite;\n    }\n    return 0;\n}\n"
