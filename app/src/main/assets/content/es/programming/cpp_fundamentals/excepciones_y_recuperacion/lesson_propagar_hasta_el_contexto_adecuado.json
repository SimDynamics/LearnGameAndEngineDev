          "id": "propagacion_con_dato_distinto",
          "question": "Predice la salida. Conserva espacios y saltos internos; no escribas comillas que el programa no produce.",
          "language": "cpp",
          "code": "#include <iostream>\n#include <stdexcept>\n\nint estimar(int piezas) {\n    if (piezas < 0 || piezas > 10) {\n        throw std::invalid_argument{\"Cantidad fuera de 0 a 10\"};\n    }\n    if (piezas == 0) { return 0; }\n    return 3 + 2 * piezas;\n}\n\nint estimacion_doble(int piezas) {\n    int minutos{estimar(piezas)};\n    return minutos * 2;\n}\n\nint main() {\n    try {\n        int total{estimacion_doble(-1)};\n        std::cout << total;\n    } catch (const std::invalid_argument& error) {\n        std::cout << \"Rechazado\";\n    }\n    std::cout << \":Fin\";\n    return 0;\n}\n",
