        {
          "type": "multiple_choice",
          "question": "Un programa recorre una colección no vacía y asigna encontrado = (valor == objetivo) en cada vuelta. ¿Qué pregunta responderá al final?",
          "options": [
            "Cuántos elementos tiene el vector.",
            "Si el último valor visitado coincidió, borrando posibles coincidencias anteriores.",
            "Si alguna visita coincidió, siempre."
          ],
          "correctIndex": 1,
          "explanation": "Reemplazar la bandera en cada visita pierde evidencia anterior."
        }
      ]
