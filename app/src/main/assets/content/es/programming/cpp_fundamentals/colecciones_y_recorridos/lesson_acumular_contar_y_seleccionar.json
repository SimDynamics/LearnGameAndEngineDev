      "blocks": [
        {
          "type": "heading",
          "text": "Una reinicialización cambia la tarea"
        },
        {
          "type": "output_prediction",
          "language": "cpp",
          "code": "#include <iostream>\n#include <vector>\n\nint main() {\n    std::vector<int> datos{2, 8, 3};\n    int suma = 0;\n    for (int valor : datos) {\n        suma = 0;\n        suma += valor;\n    }\n    std::cout << suma;\n    return 0;\n}\n",
          "question": "Predice la salida exacta, sin añadir comillas.",
          "answers": [
            "3"
          ],
          "explanation": "Esta versión pierde las visitas anteriores y termina con el último valor; no calcula el total."
