          "code": "#include <iostream>\n#include <vector>\n\nint main() {\n    std::vector<int> datos{2, 7, 4, 1};\n    int total = 0;\n    std::vector<int> elegidos;\n    for (int valor : datos) {\n        total += valor;\n        if (valor >= 4) {\n            elegidos.push_back(valor);\n        }\n    }\n    std::cout << \"Total: \" << total << \"\\n\";\n    std::cout << \"Elegidos: \" << elegidos.size() << \"\\nValores:\";\n    for (int valor : elegidos) {\n        std::cout << valor << \";\";\n    }\n    return 0;\n}\n"
