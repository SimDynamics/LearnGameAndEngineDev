          "code": "#include <iostream>\n#include <vector>\n\nint main() {\n    std::vector<int> datos{5, 2};\n    int suma = 0;\n    for (int valor : datos) {\n        suma ___ valor;\n    }\n    std::cout << suma;\n    return 0;\n}\n",
