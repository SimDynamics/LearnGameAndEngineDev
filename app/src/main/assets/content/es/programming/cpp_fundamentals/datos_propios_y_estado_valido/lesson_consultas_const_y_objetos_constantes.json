          "code": "#include <iostream>\n#include <string>\n#include <vector>\n\nclass Punto {\npublic:\n    Punto(int x, int y) : x_{x}, y_{y} {}\n    int x() const { return x_; }\n    int y() const { return y_; }\n    void mover_a(int x, int y) { x_ = x; y_ = y; }\nprivate:\n    int x_;\n    int y_;\n};\n\nbool en_eje_vertical(const Punto& punto) {\n    return punto.x() == 0;\n}\n\nint main() {\n    Punto punto{0, 6};\n    bool primero = en_eje_vertical(punto);\n    punto.mover_a(2, 6);\n    std::cout << primero << \" \" << en_eje_vertical(punto);\n    return 0;\n}\n",
          "answers": [
            "1 0"
