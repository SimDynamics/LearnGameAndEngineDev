          "code": "#include <iostream>\n\nint main() {\n    int energia{2};\n    if (energia < 0 || energia > 9) {\n        std::cout << \"Dato invalido\";\n    } else {\n        int rondas{0};\n        while (energia < 9) {\n            int aporte{3};\n            if (9 - energia < aporte) {\n                aporte = 9 - energia;\n            }\n            energia += aporte;\n            ++rondas;\n            std::cout << \"Ronda \" << rondas << \": \" << energia << \"\\n\";\n        }\n        std::cout << \"Estado=\" << energia << \";Rondas=\" << rondas;\n    }\n    return 0;\n}\n",
