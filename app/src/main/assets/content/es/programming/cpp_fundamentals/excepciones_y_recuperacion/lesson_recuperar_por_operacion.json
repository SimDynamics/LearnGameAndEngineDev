          "code": "#include <iostream>\n#include <vector>\n#include <stdexcept>\n\nint estimar(int piezas) {\n    if (piezas < 0 || piezas > 10) {\n        throw std::invalid_argument{\"Cantidad fuera de 0 a 10\"};\n    }\n    if (piezas == 0) { return 0; }\n    return 3 + 2 * piezas;\n}\n\nint main() {\n    int rechazados{0};\n    for (int piezas : std::vector<int>{-1, 11}) {\n        try {\n            std::cout << estimar(piezas);\n        } catch (const std::invalid_argument& error) {\n            ++rechazados;\n        }\n    }\n    std::cout << \"Rechazados=\" << rechazados;\n    return 0;\n}\n",
