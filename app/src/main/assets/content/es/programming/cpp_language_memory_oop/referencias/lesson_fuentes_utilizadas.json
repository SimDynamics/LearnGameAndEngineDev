  "title": "Referencias",
  "pages": [
    {
      "blocks": [
        {
          "type": "heading",
          "text": "REFERENCIAS"
        },
        {
          "type": "paragraph",
          "text": "ISO/IEC JTC 1/SC 22/WG 14. (2023). Programming languages—C (Borrador de trabajo N3096). https://www.open-std.org/jtc1/sc22/wg14/www/docs/n3096.pdf",
          "emphasis": [
            {
              "text": "Programming languages—C",
              "style": "italic"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": "ISO/IEC JTC 1/SC 22/WG 21. (2023). Working draft, standard for programming language C++ (N4950). https://www.open-std.org/jtc1/sc22/wg21/docs/papers/2023/n4950.pdf",
          "emphasis": [
            {
              "text": "Working draft, standard for programming language C++",
              "style": "italic"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": "Microsoft. (2021, 3 de agosto). IEEE floating-point representation. Microsoft Learn. https://learn.microsoft.com/en-us/cpp/build/ieee-floating-point-representation?view=msvc-170",
          "emphasis": [
            {
              "text": "IEEE floating-point representation",
              "style": "italic"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": "Microsoft. (2024, 13 de junio). Data type ranges. Microsoft Learn. https://learn.microsoft.com/en-us/cpp/cpp/data-type-ranges?view=msvc-170",
          "emphasis": [
            {
              "text": "Data type ranges",
              "style": "italic"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": "Prata, S. (2012). C++ primer plus (6.ª ed.). Addison-Wesley.",
          "emphasis": [
            {
              "text": "C++ primer plus",
              "style": "italic"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": "Stroustrup, B. (2024). Programming: Principles and practice using C++ (3.ª ed.). Addison-Wesley.",
          "emphasis": [
            {
              "text": "Programming: Principles and practice using C++",
              "style": "italic"
            }
          ]
        }
      ]
    }
  ],
