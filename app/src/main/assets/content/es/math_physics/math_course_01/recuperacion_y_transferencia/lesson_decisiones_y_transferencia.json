          "tools": [],
          "responses": [
            {
              "id": "eleccion",
              "type": "math_multiple_choice_single",
              "options": [
                {
                  "id": "a",
                  "label": "B para 5 m; A para 9 m."
                },
                {
                  "id": "b",
                  "label": "A para ambos porque su precio por metro es menor."
                },
                {
                  "id": "c",
                  "label": "B para ambos porque no tiene preparación."
                }
              ],
              "validator": {
                "type": "choice",
                "expected": [
                  "a"
                ]
              }
            }
          ],
          "feedback": {
            "correct": "La decisión se verifica con los pagos totales 42 frente a 40, y 66 frente a 72.",
            "incorrect": "Un mismo proveedor no tiene por qué convenir para todas las cantidades."
          }
        }
      ]
    },
