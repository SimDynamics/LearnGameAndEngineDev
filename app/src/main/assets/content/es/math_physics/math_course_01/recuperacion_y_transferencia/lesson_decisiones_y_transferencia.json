                  "label": "A para 5 m, en pesos",
                  "keyboard": "NUMERIC"
                },
                {
                  "id": "b5",
                  "type": "numeric",
                  "label": "B para 5 m, en pesos",
                  "keyboard": "NUMERIC"
                },
                {
                  "id": "a9",
                  "type": "numeric",
                  "label": "A para 9 m, en pesos",
                  "keyboard": "NUMERIC"
