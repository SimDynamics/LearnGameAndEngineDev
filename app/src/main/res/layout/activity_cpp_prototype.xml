<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/compilerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

    <LinearLayout
        android:id="@+id/compilerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cpp_runtime_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cpp_runtime_description"
            android:textColor="#AEB4BE"
            android:textSize="18sp" />

        <!--
            TARJETA DEL EDITOR C++
        -->

        <LinearLayout
            android:id="@+id/codeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!--
                ENCABEZADO
            -->

            <LinearLayout
                android:id="@+id/codeHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#25282E"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cpp_code_symbol"
                    android:textColor="#E1E4EB"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resetCodeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/exercise_reset_code"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:drawableStart="@drawable/ic_code_reset" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/alignCodeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/exercise_wrap_disabled"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:drawableStart="@drawable/ic_code_wrap_off" />

                <TextView
                    android:id="@+id/copyCodeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/copy_code"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:drawableStart="@drawable/ic_code_copy" />

                <TextView
                    android:id="@+id/fullscreenCodeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/exercise_fullscreen"
                    android:gravity="center"
                    android:padding="8dp"
                    android:drawableStart="@drawable/ic_code_fullscreen" />

            </LinearLayout>

            <!--
                EDITOR
            -->

            <LinearLayout
                android:id="@+id/codeEditorBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1C1F24"
                android:baselineAligned="false"
                android:minHeight="200dp"
                android:orientation="horizontal">

                <!--
                    NÚMEROS DE LÍNEA
                -->

                <ScrollView
                    android:id="@+id/lineNumberScroll"
                    android:layout_width="18dp"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                <TextView
                    android:id="@+id/lineNumbers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#181A1F"
                    android:fontFamily="monospace"
                    android:gravity="top|end"
                    android:includeFontPadding="false"
                    android:paddingStart="0dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="3dp"
                    android:paddingBottom="16dp"
                    android:textColor="#6F7782"
                    android:textSize="18sp" />

                </ScrollView>

                <!--
                    CÓDIGO
                -->

                <FrameLayout
                    android:id="@+id/editorContainer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                <com.learngraphicsprogramming.app.FreeScrollEditText
                    android:id="@+id/sourceCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:overScrollMode="never"
                    android:paddingStart="10dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:scrollHorizontally="true"
                    android:scrollbars="none"
                    android:textColor="#E6EDF3"
                    android:textSize="18sp" />

                <SeekBar
                    android:id="@+id/editorVerticalBar"
                    android:layout_width="180dp"
                    android:layout_height="28dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="-76dp"
                    android:rotation="90"
                    android:max="0"
                    android:splitTrack="false"
                    android:contentDescription="@string/code_scroll_vertical"
                    android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <SeekBar
                android:id="@+id/editorHorizontalBar"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:max="0"
                android:splitTrack="false"
                android:contentDescription="@string/code_scroll_horizontal"
                android:visibility="gone" />

        </LinearLayout>

        <Button
            android:id="@+id/runButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cpp_runtime_run"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cpp_runtime_ready"
            android:textColor="#AEB4BE"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#050607"
            android:fontFamily="monospace"
            android:minHeight="120dp"
            android:padding="18sp"
            android:textColor="#79E29D"
            android:textIsSelectable="true"
            android:textSize="18sp" />

        <!-- Compiler choice follows the result panel, before optional download controls. -->
        <LinearLayout
            android:id="@+id/clangCompilerSelectorSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clang_compiler_selector_title"
                android:textColor="#E6EDF3"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/clangCompilerRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/clang23RadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/clang_compiler_23"
                    android:textColor="#E6EDF3" />

                <RadioButton
                    android:id="@+id/clang21RadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/clang_compiler_21"
                    android:textColor="#E6EDF3" />
            </RadioGroup>
        </LinearLayout>

        <!-- Optional Play download panel; Clang 23 stays the default. -->
        <LinearLayout
            android:id="@+id/clang21FeatureSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clang21_feature_title"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/clang21_panel_description"
                android:textColor="#AEB4BE"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/clang21FeatureStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/clang21_not_installed"
                android:textColor="#D5DBE6"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/clang21ExecutionUnavailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/clang21_installed_unavailable"
                android:textColor="#F0C280"
                android:textSize="14sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/clang21FeatureProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/clang21DownloadButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/clang21_download"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/clang21CancelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/clang21_cancel_download"
                    android:textAllCaps="false"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    </ScrollView>

    <!-- Igual que LessonActivity: barra visible sólo mientras el editor
         está enfocado y el teclado de Android está abierto. -->
    <HorizontalScrollView
        android:id="@+id/programmingKeyboardBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#181A1F"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/programmingKeyboardBarContent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </HorizontalScrollView>

</LinearLayout>
