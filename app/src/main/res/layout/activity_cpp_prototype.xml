<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cpp_runtime_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cpp_runtime_description"
            android:textColor="#AEB4BE"
            android:textSize="16sp" />

        <!--
            TARJETA DEL EDITOR C++
        -->

        <LinearLayout
            android:id="@+id/codeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!--
                ENCABEZADO
            -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#25282E"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;/&gt;  C++"
                    android:textColor="#E1E4EB"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resetCodeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Reiniciar código"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:drawableStart="@drawable/ic_code_reset" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/alignCodeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Ajuste de línea desactivado"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:drawableStart="@drawable/ic_code_wrap_off" />

                <TextView
                    android:id="@+id/copyCodeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Copiar código"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:drawableStart="@drawable/ic_code_copy" />

            </LinearLayout>

            <!--
                EDITOR
            -->

            <LinearLayout
                android:id="@+id/codeEditorBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1C1F24"
                android:baselineAligned="false"
                android:minHeight="200dp"
                android:orientation="horizontal">

                <!--
                    NÚMEROS DE LÍNEA
                -->

                <TextView
                    android:id="@+id/lineNumbers"
                    android:layout_width="18dp"
                    android:layout_height="match_parent"
                    android:background="#181A1F"
                    android:fontFamily="monospace"
                    android:gravity="top|end"
                    android:includeFontPadding="false"
                    android:paddingStart="0dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="3dp"
                    android:paddingBottom="16dp"
                    android:textColor="#6F7782"
                    android:textSize="14sp" />

                <!--
                    CÓDIGO
                -->

                <EditText
                    android:id="@+id/sourceCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:includeFontPadding="false"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minHeight="200dp"
                    android:overScrollMode="never"
                    android:paddingStart="10dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:scrollHorizontally="true"
                    android:scrollbars="horizontal"
                    android:textColor="#E6EDF3"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/runButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cpp_runtime_run"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cpp_runtime_ready"
            android:textColor="#AEB4BE"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#050607"
            android:fontFamily="monospace"
            android:minHeight="120dp"
            android:padding="16dp"
            android:textColor="#79E29D"
            android:textIsSelectable="true"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>