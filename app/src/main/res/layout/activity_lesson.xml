<?xml version="1.0" encoding="utf-8"?>

<com.learngraphicsprogramming.app.LessonViewportLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:orientation="vertical">

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/lessonHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#181A1F"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="2dp">

            <LinearLayout
                android:layout_width="88dp"
                android:layout_height="match_parent"
                android:gravity="start"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/buttonBack"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/textTopLesson"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="4dp"
                    android:singleLine="true"
                    android:translationY="-5dp"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/textProgress"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:translationY="-5dp"
                android:textColor="#AEB4BE"
                android:textSize="15sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/buttonSwipeToggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/nav_swipe"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/attemptIndicator"
                android:layout_width="86dp"
                android:layout_height="58dp"
                android:layout_marginEnd="-2dp">

                <ImageView
                    android:id="@+id/imageAttemptRoute"
                    android:layout_width="43dp"
                    android:layout_height="43dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:contentDescription="Intentos disponibles"
                    android:src="@drawable/ic_attempt_programming" />

                <FrameLayout
                    android:id="@+id/attemptFillClip"
                    android:layout_width="43dp"
                    android:layout_height="43dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:clipChildren="true">

                    <ImageView
                        android:id="@+id/imageAttemptFill"
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_attempt_programming" />

                </FrameLayout>

                <TextView
                    android:id="@+id/textAttemptCount"
                    android:layout_width="22dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="8"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:translationX="12dp"
                    android:translationY="-1dp" />

                <ImageView
                    android:id="@+id/imageAttemptInfinity"
                    android:layout_width="30dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|start"
                    android:src="@drawable/ic_infinity_premium"
                    android:translationX="8dp"
                    android:translationY="-3dp"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/textAttemptPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="100%"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:translationX="-4dp"
                    android:translationY="-1dp" />

            </FrameLayout>

            <ImageButton
                android:id="@+id/buttonLessonSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ajustes de la lección"
                android:padding="4dp"
                android:src="@drawable/ic_settings" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/lessonProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:progressBackgroundTint="#30323A"
            android:progressTint="@color/accent_default" />

    </LinearLayout>

    <!-- Contenido -->
    <ScrollView
        android:id="@+id/lessonScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/lessonContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp" />

            <Button
                android:id="@+id/buttonContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="32dp"
                android:minHeight="58dp"
                android:text="@string/continue_lesson"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

    <!-- Barra de atajos para edición de código -->
    <HorizontalScrollView
        android:id="@+id/programmingKeyboardBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#181A1F"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/programmingKeyboardBarContent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

    </HorizontalScrollView>

</com.learngraphicsprogramming.app.LessonViewportLayout>
