<?xml version="1.0" encoding="utf-8"?>

<com.learngraphicsprogramming.app.LessonViewportLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lesson_canvas"
    android:orientation="vertical">

    <!-- Compact windows keep two rows; wide windows center labels and actions.
         The progress bar always retains the full window width. -->
    <LinearLayout
        android:id="@+id/lessonHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lesson_header"
        android:orientation="vertical">

        <com.learngraphicsprogramming.app.LessonHeaderBody
            android:id="@+id/lessonHeaderBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/lessonHeaderActions"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="2dp">

                <TextView
                    android:id="@+id/buttonBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/lesson_back_symbol"
                    android:contentDescription="@string/nav_go_back"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- 38dp previous silhouette x 0.8 = 30.4dp, inside a 48dp touch target. -->
                <ImageView
                    android:id="@+id/buttonNarrationToggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/lesson_narration_hide_controls"
                    android:padding="8.8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_person_speaking" />

                <com.learngraphicsprogramming.app.LessonLanguageButton
                    android:id="@+id/buttonLessonLanguage"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/lesson_header_language"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/lesson_text_secondary"
                    android:src="@drawable/ic_lesson_language" />

                <!-- Keep the existing 43dp fill geometry used by LessonActivity.
                     Scale the whole indicator, including count and percentage, to 80%. -->
                <com.learngraphicsprogramming.app.LessonAttemptTouchTarget
                    android:id="@+id/attemptIndicatorSlot"
                    android:layout_width="68.8dp"
                    android:layout_height="64dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <FrameLayout
                        android:id="@+id/attemptIndicator"
                        android:layout_width="86dp"
                        android:layout_height="58dp"
                        android:layout_gravity="top|center_horizontal"
                        android:scaleX="0.8"
                        android:scaleY="0.8"
                        android:translationY="-5.8dp">

                        <ImageView
                            android:id="@+id/imageAttemptRoute"
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:contentDescription="@string/lesson_available_attempts"
                            android:src="@drawable/ic_attempt_programming" />

                        <FrameLayout
                            android:id="@+id/attemptFillClip"
                            android:layout_width="43dp"
                            android:layout_height="43dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:clipChildren="true">

                            <ImageView
                                android:id="@+id/imageAttemptFill"
                                android:layout_width="43dp"
                                android:layout_height="43dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_attempt_programming" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/textAttemptCount"
                            android:layout_width="22dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:translationX="12dp"
                            android:translationY="-1dp" />

                        <ImageView
                            android:id="@+id/imageAttemptInfinity"
                            android:layout_width="30dp"
                            android:layout_height="26dp"
                            android:layout_gravity="top|start"
                            android:src="@drawable/ic_infinity_premium"
                            android:translationX="8dp"
                            android:translationY="-1dp"
                            android:visibility="gone"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/textAttemptPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:translationX="-4dp"
                            android:translationY="-1dp" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/textAttemptRemaining"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:visibility="invisible"     android:textStyle="bold" />
                </com.learngraphicsprogramming.app.LessonAttemptTouchTarget>

                <ImageButton
                    android:id="@+id/buttonLessonSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/lesson_settings_title"
                    android:padding="4dp"
                    android:src="@drawable/ic_settings" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lessonHeaderLabels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/textTopLesson"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/lesson_text_secondary"
                    android:textSize="15sp" />

            </LinearLayout>

        </com.learngraphicsprogramming.app.LessonHeaderBody>

        <ProgressBar
            android:id="@+id/lessonProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:progressBackgroundTint="@color/lesson_outline"
            android:progressTint="@color/accent_default" />

    </LinearLayout>

    <!-- Contenido -->
    <ScrollView
        android:id="@+id/lessonScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.learngraphicsprogramming.app.LessonPageContentLayout
                android:id="@+id/lessonContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="0dp"
                android:paddingTop="24dp"
                android:paddingEnd="0dp"
                android:paddingBottom="16dp" />

            <Button
                android:id="@+id/buttonContinue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="32dp"
                android:minHeight="58dp"
                android:text="@string/continue_lesson"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

    <!-- Barra de atajos para edición de código -->
    <HorizontalScrollView
        android:id="@+id/programmingKeyboardBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/lesson_header"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/programmingKeyboardBarContent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

    </HorizontalScrollView>

</com.learngraphicsprogramming.app.LessonViewportLayout>
