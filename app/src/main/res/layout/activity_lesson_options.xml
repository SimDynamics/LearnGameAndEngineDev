<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textAllCaps="false"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/textLessonNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/accent_text_default"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/lesson_settings_title"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLessonOptionsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/lesson_settings_programming_description"
            android:textColor="#AEB4BE"
            android:textSize="16sp" />

        <!-- TAMAÑO DEL CONTENIDO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/lesson_settings_content_size_title"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#202126"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <Switch
                android:id="@+id/switchUseGlobalTextSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:text="@string/lesson_settings_use_global_size"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="@string/lesson_settings_use_global_size_description"
                android:textColor="#8F959F"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#30323A" />

            <TextView
                android:id="@+id/textLessonTextSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tamaño del curso · 100 %"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekLessonTextSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="75"
                android:progress="25" />

            <TextView
                android:id="@+id/textLessonTextSizePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/settings_content_size_preview"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="75 %                                  150 %"
                android:textColor="#8F959F"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- PROTECCIÓN DEL AJUSTE DE LÍNEA -->

        <TextView
            android:id="@+id/textCodeWrapHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/lesson_settings_wrap_title"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/codeWrapSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#202126"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <Switch
                android:id="@+id/switchAllowGlobalWrapOverwrite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:text="@string/settings_allow_global_override"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lesson_settings_wrap_description"
                android:textColor="#8F959F"
                android:textSize="14sp" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonSaveCourseSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="62dp"
            android:text="@string/lesson_settings_save_course"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <!-- PROGRAMACIÓN -->

        <TextView
            android:id="@+id/textProgrammingHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/settings_programming_color_title"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonEditProgrammingShortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="62dp"
            android:text="@string/lesson_settings_edit_shortcuts"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textProgrammingShortcutsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/lesson_settings_shortcuts_description"
            android:textColor="#8F959F"
            android:textSize="14sp" />

        <!-- PROGRESO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/nav_progress_title"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonResetLesson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="62dp"
            android:text="@string/lesson_settings_reset"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/lesson_settings_reset_description"
            android:textColor="#8F959F"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>