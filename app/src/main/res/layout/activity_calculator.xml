<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/calculator_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101114"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/calculator_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/calculator_back"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="×"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/calculator_title"
                    android:textColor="#EBEFF5"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/calculator_angle_mode"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="@string/calculator_rad"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/calculator_panels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/calculator_expression_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/calculator_input_label"
                            android:textColor="#AEB7C6"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/calculator_native_keyboard"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/calculator_native_keyboard"
                            android:textAllCaps="false"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/calculator_input_host"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fillViewport="true" />

                    <LinearLayout
                        android:id="@+id/calculator_ime_navigation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/calculator_ime_left"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="←" />

                        <Button
                            android:id="@+id/calculator_ime_right"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="→" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/calculator_navigation_hint"
                        android:textColor="#AEB7C6"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/calculator_result_label"
                            android:textColor="#AEB7C6"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/calculator_evaluate"
                            android:layout_width="72dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/calculator_evaluate"
                            android:minWidth="0dp"
                            android:text="="
                            android:textSize="23sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/calculator_result_host"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fillViewport="true"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/calculator_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:minHeight="32dp"
                        android:text="@string/calculator_empty_result"
                        android:textColor="#AEB7C6"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/calculator_keypad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
