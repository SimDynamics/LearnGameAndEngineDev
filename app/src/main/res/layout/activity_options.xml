<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textAllCaps="false"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Opciones"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Configuración general de Learn Graphics Programming"
            android:textColor="#AEB4BE"
            android:textSize="17sp" />

        <!-- FLUJO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Flujo de aprendizaje"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="Controla cómo continúa la aplicación cuando terminas contenido."
            android:textColor="#AEB4BE"
            android:textSize="16sp" />

        <!-- TARJETA: CONTINUIDAD AUTOMÁTICA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202126"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Continuidad automática"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="16dp"
                android:text="Decide hasta dónde puede continuar automáticamente el estudio."
                android:textColor="#8F959F"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchBetweenLessons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:text="Avanzar entre lecciones"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Al terminar una lección, abre directamente la siguiente de la misma unidad."
                android:textColor="#8F959F"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="#30323A" />

            <Switch
                android:id="@+id/switchBetweenUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:text="Avanzar entre unidades"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Al terminar una unidad, abre la primera lección de la siguiente."
                android:textColor="#8F959F"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="#30323A" />

            <Switch
                android:id="@+id/switchBetweenCourses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:text="Avanzar entre cursos"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Al terminar un curso, abre la primera lección del siguiente curso disponible."
                android:textColor="#8F959F"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- GESTOS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Gestos de navegación"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="Configura cómo responden las lecciones a los gestos."
            android:textColor="#AEB4BE"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202126"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <Switch
                android:id="@+id/switchSwipeFinish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:text="Terminar una lección deslizando"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Permite que un deslizamiento hacia adelante en la última página tenga el mismo efecto que «Terminar lección»."
                android:textColor="#8F959F"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- GUARDAR -->

        <!-- APARIENCIA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Apariencia"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="Personaliza el color de acento de Learn Graphics Programming."
            android:textColor="#AEB4BE"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="Personaliza el tamaño del contenido de las lecciones y el color de acento de Learn Graphics Programming."
            android:textColor="#AEB4BE"
            android:textSize="16sp" />

        <!-- TAMAÑO GLOBAL DEL TEXTO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202126"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/textGlobalTextSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tamaño del contenido · 100 %"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Se aplica a todas las lecciones que tengan activada la opción «Usar tamaño global»."
                android:textColor="#8F959F"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekGlobalTextSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="75"
                android:progress="25" />

            <TextView
                android:id="@+id/textGlobalTextSizePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Vista previa de lectura"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="75 %                                  150 %"
                android:textColor="#8F959F"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- AJUSTE DE LÍNEA GLOBAL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Código"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="Configura el comportamiento general de los bloques de código."
            android:textColor="#AEB4BE"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202126"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <Switch
                android:id="@+id/switchGlobalCodeWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:text="Ajuste de línea predeterminado"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Al guardar un cambio, este valor se aplica a todos los cursos que permiten ser sobrescritos desde las opciones globales."
                android:textColor="#8F959F"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- COLOR DE ACENTO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202126"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Color de acento"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="18dp"
                android:text="Elige el color principal mediante sus valores RGB. El tono secundario para textos se calculará automáticamente."
                android:textColor="#8F959F"
                android:textSize="14sp" />

            <!-- ROJO -->

            <TextView
                android:id="@+id/textAccentRed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rojo · 187"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekAccentRed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="187" />

            <!-- VERDE -->

            <TextView
                android:id="@+id/textAccentGreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Verde · 134"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekAccentGreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="134" />

            <!-- AZUL -->

            <TextView
                android:id="@+id/textAccentBlue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Azul · 252"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekAccentBlue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="252" />

            <!-- VALOR RGB -->

            <TextView
                android:id="@+id/textAccentRgb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="RGB(187, 134, 252)"
                android:textColor="#AEB4BE"
                android:textSize="15sp" />

            <!-- VISTA PREVIA -->

            <LinearLayout
                android:id="@+id/accentPreview"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textAccentPreviewPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color principal"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textAccentPreviewSecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Color secundario"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- DATOS Y PROGRESO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Datos y progreso"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="Administra el progreso guardado de las rutas de aprendizaje."
            android:textColor="#AEB4BE"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202126"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ruta de Programación"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Elimina el progreso, las respuestas y las páginas guardadas de todos los cursos de Programación."
                android:textColor="#8F959F"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonResetProgrammingRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="58dp"
                android:text="Reiniciar progreso de Programación"
                android:textAllCaps="false"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Los ajustes generales y las configuraciones particulares de los cursos se conservarán."
                android:textColor="#8F959F"
                android:textSize="14sp" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minHeight="62dp"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <!-- RESTABLECER EXCEPCIONES DE AJUSTE DE LÍNEA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Excepciones de ajuste de línea"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="Restablece las excepciones individuales de una ruta y vuelve a permitir que sus cursos reciban el ajuste de línea predeterminado."
            android:textColor="#AEB4BE"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202126"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Programación"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Todos los cursos de Programación volverán a permitir la sobrescritura global y recibirán el ajuste de línea predeterminado actual."
                android:textColor="#8F959F"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonResetProgrammingWrapExceptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="58dp"
                android:text="Restablecer excepciones de Programación"
                android:textAllCaps="false"
                android:textSize="17sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="#30323A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matemáticas y Física"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Restablecerá las excepciones de todos los cursos de Matemáticas y Física cuando esta ruta tenga contenido disponible."
                android:textColor="#8F959F"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonResetMathPhysicsWrapExceptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="58dp"
                android:text="Restablecer excepciones de Matemáticas y Física"
                android:textAllCaps="false"
                android:textSize="17sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>