<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="18dp" />

    <gradient
        android:angle="45"
        android:startColor="#6E5310"
        android:centerColor="#D4AF37"
        android:endColor="#8C6A12" />

    <stroke
        android:width="1dp"
        android:color="#F2DC8A" />

    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp" />
</shape>