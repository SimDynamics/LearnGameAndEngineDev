<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep user progress/settings, not hundreds of MB of regenerable speech. -->
        <exclude domain="file" path="kokoro-narration-cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="kokoro-narration-cache/" />
    </device-transfer>
</data-extraction-rules>
