package com.learngraphicsprogramming.app.narration

/** Exercise the real Windows-generated normalizer, not replacement-string stubs. */
fun main() {
    fun normalized(text: String) = text.replace(Regex("\\s+"), " ").trim()
    val failures = mutableListOf<String>()
    var assertions = 0
    fun verify(value: Boolean, message: String) { assertions++; if (!value) failures += message }
    val cases = listOf(
        "`\"\"`" to "comilla doble comilla doble",
        "\"\"" to "comilla doble comilla doble",
        "`//`" to "doble diagonal",
        "//" to "doble diagonal",
        "`\"//\"`" to "comilla doble doble diagonal comilla doble",
        "`'a'`" to "abre comilla simple a cierra comilla simple"
    )
    for ((source, expected) in cases) {
        val ordinary = SpanishTechnicalSpeech.prepare(source).text
        verify(normalized(ordinary) == expected, "Wrong speech for $source: $ordinary")
        val owners = mutableListOf<Triple<Int,Int,String>>()
        val observed = SpanishTechnicalSpeech.prepareObserved(source) { start, end, spoken ->
            verify(start in 0..source.length && end in start..source.length, "Invalid source owner for $source: $start,$end")
            owners += Triple(start,end,spoken)
        }
        verify(normalized(observed.text) == expected, "Wrong observed speech for $source: ${observed.text}")
        verify(normalized(owners.joinToString("") { it.third }) == expected, "Observed and spoken output diverged: $source $owners")
    }
    // Full source uses the app's explicit code span. Unmarked prose deliberately
    // recognizes only local technical fragments, not every ordinary quotation.
    val statement = "`std::cout << \"Hola\";`"
    val spoken = SpanishTechnicalSpeech.prepare(statement).text
    verify(Regex("comilla doble").findAll(spoken).count() == 2 && "abre comilla doble" !in spoken && "cierra comilla doble" !in spoken,
        "Wrong full code delimiter reading: $spoken")
    val prose = "Fuera de un literal, // comienza un comentario que llega hasta el final de la línea."
    val comment = SpanishTechnicalSpeech.prepare(prose).text
    verify("doble diagonal" in comment, "Wrong prose comment: $comment")
    val url = "https://example.org/a"
    val urlSpeech = SpanishTechnicalSpeech.prepare(url).text
    verify(urlSpeech == url, "Changed URL: $urlSpeech")
    val math = SpanishTechnicalSpeech.prepare("a / b", "inline").text
    verify(math == "a / b", "Changed mathematical slash: $math")
    val slash = SpanishTechnicalSpeech.prepare("`/`").text
    verify("doble diagonal" !in slash, "Changed single slash: $slash")
    val letter = SpanishTechnicalSpeech.prepare("la letra n: juntas").text
    verify("ene" in letter && "letra n" !in letter, "Lost technical named-letter reading: $letter")
    val source = "`\"//\"`"
    val owners = mutableListOf<Triple<Int,Int,String>>()
    val prepared = SpanishTechnicalSpeech.prepareForReading(source) { a,b,s -> owners += Triple(a,b,s) }
    verify("doble diagonal" in prepared.text && owners.all { it.first in 0..source.length && it.second in it.first..source.length },
        "Wrong Kokoro reading/source ownership: ${prepared.text}; $owners")
    val background = SpanishTechnicalSpeech.prepareForKokoro(source).text
    verify(prepared.text == background, "Foreground/background preparation diverged: ${prepared.text}; $background")

    // Real U1L5 feedback: the trailing reference follows a technical name.
    // It must not be consumed as main(author, year) by codeEnd().
    val feedback = "#include <iostream> permite usar los recursos de entrada y salida de esa cabecera; no muestra por sí misma un mensaje. En estos programas, la salida la producen las instrucciones con std::cout dentro de main (Stroustrup, 2024)."
    val citations = listOf(
        feedback,
        "main (Stroustrup, 2024).",
        "std::cout (Lippman, Lajoie y Moo, 2013).",
        "Texto (Stroustrup, 2024a, pp. 12–14).",
        "Texto (García et al., 2020; Stroustrup, 2024).",
        "Texto (Microsoft, s. f.).",
        "𐐀 En main (Stroustrup, 2024) continúa la explicación."
    )
    fun cleaned(value: String) = normalized(value).replace(Regex(" +([,.;:!?])"), "$1")
    for (citation in citations) {
        val opening = citation.indexOf('(')
        val closing = citation.indexOf(')', opening)
        val body = citation.substring(opening + 1, closing)
        val plain = SpanishTechnicalSpeech.prepare(citation).text
        verify("paréntesis" !in plain && '(' !in plain && ')' !in plain,
            "Citation delimiters were spoken instead of paused: $citation => $plain")
        verify(", $body" in plain, "Lost short citation pause, author or date: $plain")
        val observedPieces = mutableListOf<Triple<Int,Int,String>>()
        val observedCitation = SpanishTechnicalSpeech.prepareObserved(citation) { a,b,s ->
            observedPieces += Triple(a,b,s)
        }
        verify(observedCitation.text == plain, "Observed citation reading diverged: $citation")
        verify(cleaned(observedPieces.joinToString("") { it.third }) == plain,
            "Citation source ownership changed the prepared words: $citation")
        verify(observedPieces.any { it.first == opening && it.second == opening + 1 && it.third == ", " } &&
            observedPieces.any { it.first == opening + 1 && it.second == closing && it.third == body } &&
            observedPieces.any { it.first == closing && it.second == closing + 1 && it.third.isEmpty() },
            "Citation punctuation or author/year lost their original UTF-16 owners: $citation")
        verify(observedPieces.all { it.first in 0..citation.length && it.second in it.first..citation.length },
            "Citation introduced an invalid source range: $citation")
        val livePieces = mutableListOf<Triple<Int,Int,String>>()
        val live = SpanishTechnicalSpeech.prepareForReading(citation) { a,b,s -> livePieces += Triple(a,b,s) }
        val queued = SpanishTechnicalSpeech.prepareForKokoro(citation)
        verify(live.text == queued.text && "paréntesis" !in live.text && ", $body" in live.text,
            "Foreground/background citation preparation diverged: $citation => ${live.text}")
        verify(cleaned(livePieces.joinToString("") { it.third }) == live.text,
            "Kokoro citation owners no longer reconstruct prepared speech: $citation")
    }
    // Actual technical parentheses must remain audible, including a call whose
    // argument spelling looks like the author/year pair but belongs to code.
    for (technical in listOf("`main()`", "main (argc, argv);", "main(Stroustrup, 2024);",
            "main (Stroustrup, 2024);", "`main (Stroustrup, 2024)`", "`\"(Stroustrup, 2024)\"`")) {
        val result = SpanishTechnicalSpeech.prepare(technical).text
        verify("abre paréntesis" in result && "cierra paréntesis" in result,
            "Citation handling suppressed technical parentheses: $technical => $result")
    }
    for (mode in listOf("inline", "block")) {
        val formula = "(X, 2024)"
        verify(SpanishTechnicalSpeech.prepare(formula, mode).text == formula,
            "Citation handling changed a forced mathematical group")
    }
    for (untouched in listOf("(X, 2024)", "Texto (Stroustrup, sin fecha)", "Texto (Stroustrup, 2024",
            "https://example.org/(Stroustrup,2024)")) {
        verify(SpanishTechnicalSpeech.prepare(untouched).text == untouched,
            "Citation handling changed a non-citation or unfinished group: $untouched")
    }


    // prepareImpl trims whitespace before punctuation after emitting source owners.
    fun outputCanonical(value: String) = normalized(value).replace(Regex(" +([,.;:!?])"), "$1")
    // A backtick is display decoration, not proof that an output label is code.
    for (source in listOf(
        "Pulsa «Compilar, ejecutar y comprobar». El objetivo de esta actividad es `Llaves: 11`, con salto final opcional.",
        "La salida es `Llaves: 11`.",
        "El programa debe mostrar `Puntos: 3`.",
        "La salida esperada es `Objetos: 8`.",
        "Un prompt es un mensaje que indica qué dato espera un programa. Por ejemplo, `Cantidad: ` puede avisar de que se recibirá una cantidad. Es una salida producida por `std::cout`.",
        "Guarda el estado inicial antes del aumento y muestra el nombre, `Inicio:` y `Ahora:` en tres líneas, con los mismos espacios practicados.",
        "La consola presenta el mensaje `Cantidad: 7`.",
        "El programa imprimirá los mensajes `Inicio: 7` y `Ahora: 12`.",
        "Las instrucciones de salida muestran `Objetos: 8`.",
        "La consola muestra la etiqueta `Inicio:`.",
        "El prompt contiene la cadena `Cantidad: `.",
        "La salida incluye la etiqueta `Inicio:` y la cadena `Llaves: 11`.")) {
        val output = SpanishTechnicalSpeech.prepare(source).text
        verify("dos puntos" !in output && Regex("(?:Llaves|Puntos|Objetos|Cantidad|Inicio|Ahora),").containsMatchIn(output),
            "Output colon was named instead of paused: $source => $output")
        val undecorated = SpanishTechnicalSpeech.prepare(source.replace("`", "")).text
        verify("dos puntos" !in undecorated,
            "An undecorated prose/output colon became a technical symbol: $source => $undecorated")
        val pieces = mutableListOf<Triple<Int,Int,String>>()
        val traced = SpanishTechnicalSpeech.prepareObserved(source) { first, last, value ->
            pieces += Triple(first,last,value)
        }
        verify(outputCanonical(traced.text) == outputCanonical(output) &&
            outputCanonical(pieces.joinToString("") { it.third }) == outputCanonical(output),
            "Output colon changed observed speech: $source; $pieces")
        val outputColons = Regex("`([^`]+)`").findAll(source).filter { "::" !in it.groupValues[1] }
            .flatMap { span -> span.range.filter { source[it] == ':' }.asSequence() }.toList()
        verify(outputColons.isNotEmpty() && outputColons.all { colon ->
            pieces.any { it.first == colon && it.second == colon + 1 && it.third == ", " }
        } && pieces.all { it.first in 0..source.length && it.second in it.first..source.length },
            "Output colon lost exact source ownership: $source; $pieces")
        val reading = SpanishTechnicalSpeech.prepareForReading(source) { _,_,_ -> }.text
        verify(reading == SpanishTechnicalSpeech.prepareForKokoro(source).text && "dos puntos" !in reading,
            "Foreground/background output-label speech diverged: $source")
    }
    for (source in listOf("El signo `:` separa los campos.", "La etiqueta `salida:` pertenece al código.",
        "`std::cout << \"Llaves: 11\";`", "`condicion ? uno : dos`",
        "La salida es `7:3`.", "En la consola, el signo `:` separa los campos.",
        "La cadena `\"Inicio: 7\"` conserva sus caracteres.",
        "En el código de salida, la etiqueta `salida:` permite saltar allí.",
        "La etiqueta C++ `salida:` precede a una sentencia.",
        "La etiqueta de sentencia `salida:` precede a una instrucción.",
        "`" + "x".repeat(500) + " consola ` y la etiqueta `salida:` precede a una sentencia.",
        "La consola presenta un resultado. La palabra `Inicio:` pertenece a una gramática.")) {
        val spoken = SpanishTechnicalSpeech.prepare(source).text
        verify("dos puntos" in spoken, "A genuinely technical colon lost its name: $source => $spoken")
    }
    val namespaced = SpanishTechnicalSpeech.prepare("El objetivo es `std::cout << 11;`.").text
    verify("operador de resolución de ámbito" in namespaced,
        "Output context wrongly turned a real C++ expression into prose: $namespaced")

    // Styling is irrelevant to the conjunction. Only a named/quoted source
    // letter is a technical y; ordinary coordination keeps its source word.
    for (source in listOf("Letras y palabras.", "El texto contiene letras y palabras.",
        "Cada letra y las palabras permanecen.", "La letra y la palabra permanecen.",
        "Cada carácter y el intento permanecen.")) {
        val output = SpanishTechnicalSpeech.prepare(source).text
        verify("i griega" !in output && "y" in output,
            "An ordinary conjunction became a technical letter: $source => $output")
        val pieces = mutableListOf<Triple<Int,Int,String>>()
        val traced = SpanishTechnicalSpeech.prepareObserved(source) { first, last, value -> pieces += Triple(first,last,value) }
        verify(outputCanonical(traced.text) == outputCanonical(output) &&
            outputCanonical(pieces.joinToString("") { it.third }) == outputCanonical(output),
            "Conjunctive y changed observed source ownership: $source")
        verify(SpanishTechnicalSpeech.prepareForReading(source) { _,_,_ -> }.text == SpanishTechnicalSpeech.prepareForKokoro(source).text,
            "Conjunctive y differs between immediate and anticipated speech: $source")
    }
    for (source in listOf("La letra y es una consonante.", "El carácter y: una letra.",
        "La letra y la puedes escribir en minúscula.", "El carácter y lo debemos escribir de nuevo.",
        "La variable `y` contiene 1.", "`int y = 1;` conserva la variable.")) {
        verify("i griega" in SpanishTechnicalSpeech.prepare(source).text,
            "A genuinely named C++ letter lost its technical reading: $source")
    }

    // The user's original U2L3 feedback lacks delimiters/terminators at two
    // code/prose boundaries. The Windows parser must stop before Spanish words;
    // replacing accents or altering readCode would conceal the actual defect.
    val oldTurnos = "++turnos aumenta en una unidad el valor existente. turnos = 1 lo reemplaza por uno; int turnos = 1 es una definición, no una actualización del objeto existente."
    val currentTurnos = "`++turnos;` aumenta en una unidad el valor existente. `turnos = 1;` lo reemplaza por uno. `int turnos = 1;` es una definición, no una actualización del objeto existente."
    val spanishProse = listOf(oldTurnos, currentTurnos,
        "definición", "actualización", "Es una definición, no una actualización del objeto existente.",
        "turnos = 1 lo reemplaza por uno; int turnos = 1 es una definición, no una actualización.",
        "int turnos = cantidad + 1 es una definición, no una actualización.",
        "turnos += cantidad * 2 permite una actualización, no una definición.",
        "int turnos = f(1, 2) es una definición, no una actualización.",
        "𐐀 int turnos = 1 es una definición, no una actualización.")
    for (source in spanishProse) {
        val output = SpanishTechnicalSpeech.prepare(source).text
        for (word in listOf("definición", "actualización", "lo reemplaza por uno")) if (word in source)
            verify(word in output, "Spanish prose entered identifier spelling: $source => $output")
        val pieces = mutableListOf<Triple<Int,Int,String>>()
        val observed = SpanishTechnicalSpeech.prepareObserved(source) { a,b,s -> pieces += Triple(a,b,s) }
        verify(outputCanonical(observed.text) == outputCanonical(output) &&
            outputCanonical(pieces.joinToString("") { it.third }) == outputCanonical(output),
            "Code/prose boundaries changed source ownership: $source; $pieces")
        verify(pieces.all { it.first in 0..source.length && it.second in it.first..source.length },
            "An accented or supplementary character moved original UTF-16 owners: $source")
        val live = SpanishTechnicalSpeech.prepareForReading(source) { _,_,_ -> }.text
        val queued = SpanishTechnicalSpeech.prepareForKokoro(source).text
        verify(live == queued, "Code/prose boundaries differ between live and anticipated narration: $source")
        for (word in listOf("definición", "actualización")) if (word in source)
            verify(word in live, "Kokoro preparation split a Spanish word: $source => $live")
    }
    val technicalOriginal = SpanishTechnicalSpeech.prepare(oldTurnos).text
    verify("incremento" in technicalOriginal && Regex("\\basigna\\b").findAll(technicalOriginal).count() == 2,
        "Bounding prose erased genuine C++ operations: $technicalOriginal")
    // Unicode identifiers are genuine code here, not Spanish prose to exempt.
    // Keep their historical explicit-code pronunciation and exact source owner.
    for (code in listOf("definición = actualización;", "int definición = 1;", "turnos = f(1, 2);", "turnos = \"es una definición\";")) {
        val implicit = SpanishTechnicalSpeech.prepare(code).text
        val explicit = SpanishTechnicalSpeech.prepare("`$code`").text
        verify(normalized(implicit) == normalized(explicit),
            "A real identifier, grouped operand or string lost its code reading: $code => $implicit / $explicit")
    }

    check(failures.isEmpty()) { failures.joinToString("\n") }
    println("PASS $assertions Windows technical-speech assertions: delimiters, empty literals, double diagonal in prose/code/strings, single quotes/slashes, URLs, math, named letters, provenance and Kokoro preparation")
}
