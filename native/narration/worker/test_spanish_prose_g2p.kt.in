package com.learngraphicsprogramming.app.narration

import com.learngraphicsprogramming.app.narration.phonemes.SpanishFluidG2P
import java.io.File
import java.security.MessageDigest
import org.json.JSONArray

/** Real generated Windows normalization, continuous G2P and observed phone ranges. */
fun main(args: Array<String>) {
    var assertions = 0
    var sentences = 0
    fun verify(condition: Boolean, message: String) {
        assertions++
        check(condition) { message }
    }
    fun phoneSha256(phones: String) = MessageDigest.getInstance("SHA-256").digest(phones.toByteArray(Charsets.UTF_8))
        .joinToString("") { "%02x".format(it.toInt() and 255) }
    fun checked(source: String, label: String, mode: String = "auto"): List<String> {
        val prepared = SpanishTechnicalSpeech.prepareForKokoro(source, mode).text
        val live = SpanishTechnicalSpeech.prepareForReading(source, mode) { _, _, _ -> }.text
        verify(prepared == live, "$label changed foreground/background preparation")
        val parts = NarrationSegments.sentences(listOf(prepared))
        verify(parts.isNotEmpty(), "$label has no original sentence")
        for (part in parts) {
            sentences++
            val phones = MixedSpanishG2P.phonemizePrepared(part, emptyMap())
            verify(phones.isNotBlank(), "$label has no real phonemes: $part")
            val trace = MixedSpanishG2P.traceWordsPrepared(part)
                ?: error("$label lost real phone provenance: $part")
            verify(trace.phonemes == phones, "$label changed synthesis while observing word ranges")
            verify(trace.words.map { it.word } == NarrationSpokenWords.lexemes(part).map { it.canonical },
                "$label lost or invented original lexical words: $part")
            var previous = 0
            for (word in trace.words) {
                verify(word.start >= previous && word.start < word.endExclusive && word.endExclusive <= phones.length,
                    "$label has invalid observed phone range for " + word.word)
                previous = word.endExclusive
            }
        }
        return parts
    }

    val prose = listOf(
        "El carácter y_el continúa.",
        "La selección_útil continúa.",
        "El dato nombre__total y _inicio_ conservan el texto.",
        "El registro datos_12 contiene 27 unidades."
    )
    for (source in prose) {
        val parts = checked(source, source)
        verify(parts.joinToString(" ") { ManualEnglishSpeech.strip(it) } == source,
            "Unmarked prose changed its original preparation or recording identity: $source")
        verify(parts.none { "guion bajo" in it || ManualEnglishSpeech.spans(it).isNotEmpty() },
            "An unmarked prose underscore inferred technical pronunciation: $source")
        val normalized = SpanishFluidG2P.normalizeText(source)
        verify('_' !in normalized && normalized.none(Char::isDigit), "G2P left raw notation: $normalized")
    }
    // A separator has no phoneme of its own. Both inputs must preserve the
    // same Spanish words and contextual joining in the continuous frontend.
    val conjunction = prose.first()
    val plain = conjunction.replace('_', ' ')
    verify(MixedSpanishG2P.phonemizePrepared(SpanishTechnicalSpeech.prepareForKokoro(conjunction).text, emptyMap()) ==
        MixedSpanishG2P.phonemizePrepared(SpanishTechnicalSpeech.prepareForKokoro(plain).text, emptyMap()),
        "The residual prose separator inserted a technical sound")
    checked("El dato nombre_total acompaña a `std::cout << 12;`.", "mixed prose and explicit code")

    // Residual slashes retain the production contextual reading. The observer
    // must reconcile each uniquely attributable insertion, including foreign
    // atoms, without replacing a slash with punctuation or inventing a word.
    for (source in listOf(
            "El control distingue duplicados/ausencia.",
            "El control distingue duplicados/ausencia/mala gramática.",
            "El control distingue carga/lectura/validación/escritura.",
            "El control carga/lectura/validación acompaña a `std::cout`.")) {
        checked(source, source)
    }
    // Repeated identical words make the insertion location ambiguous; raw
    // structured fractions have no independently proven lexical projection.
    // Keep real pronunciation available while refusing unsupported ownership.
    for (source in listOf("El ejemplo barra/barra/barra permanece.", "Fracción \\frac{1}{2}.")) {
        val prepared = "\ue002$source"
        verify(MixedSpanishG2P.phonemizePrepared(prepared, emptyMap()).isNotBlank(),
            "A conservative trace fallback suppressed the original pronunciation")
        verify(MixedSpanishG2P.traceWordsPrepared(prepared) == null,
            "Ambiguous or structured notation acquired invented phone ownership: $source")
    }

    // These exact production phonemes were captured on 8259a709 before the
    // percent observer change. A residual sign consumes its spoken words but
    // must not invent a source lexeme or alter explicit C++ remainder speech.
    val percentCases = listOf(
        "La guardia completa se ejecuta antes del operador %." to
            "e0668db8e9a2cb6e528746a66a063ded3db525a5ee2fec49217abc7ee3464abc",
        "La señal % permanece visible." to
            "2b4f1476b1885db5fb0e8e658cffcd3c0ef0d7e6aa610561984c7cd91b0e4bab",
        "El porcentaje 25% conserva el dato." to
            "32eada8ff65ef42b764595389372ea462b4de546b3ef383ebc2d8222d5b828cb",
        "El signo % acompaña a `std::cout`." to
            "8174c66c51ca599974adba822d0c770dc6040d091be2ed1c1891f6b662b4c74c",
        "El cálculo `17 % 5` conserva el operador." to
            "aef18add77296a28dda9809169d98e4e6d8e68573a89098a97b0b5b22d74b1c0",
        "Los signos % y % conservan la lectura." to
            "9c497c55a9099a981660b5454ba360cb08282cbc4b259076b343e6fe8e7c68c4"
    )
    for ((source, previousPhones) in percentCases) for (mode in listOf("auto", "cpp")) {
        val parts = checked(source, "percent/$mode/$source", mode)
        verify(parts.size == 1, "A percent observation changed the original sentence boundary")
        verify(phoneSha256(MixedSpanishG2P.phonemizePrepared(parts.single(), emptyMap())) == previousPhones,
            "Observing a percent sign changed its existing production phonemes: $source")
        if ('`' !in source) verify(ManualEnglishSpeech.strip(parts.single()) == source,
            "Residual percent prose changed its original preparation or recording identity: $source")
    }

    // Explicit references and actual source syntax keep their original code
    // reading; a historical bookmark still authenticates its previous words.
    for (source in listOf("El valor `nombre_total` permanece.", "`int nombre_total = 12;` conserva el dato.",
            "foo_bar()", "int nombre_total = 12;")) {
        val current = checked(source, source)
        val previous = WindowsNarrationSpeechRules.withPreviousProseInference(true) {
            SpanishTechnicalSpeech.prepareForKokoro(source).text
        }
        verify(current == NarrationSegments.sentences(listOf(previous)), "Explicit code changed its historical preparation")
        verify(current.any { "guion bajo" in ManualEnglishSpeech.strip(it) }, "Explicit code lost underscore pronunciation")
    }
    val previousProse = WindowsNarrationSpeechRules.withPreviousProseInference(true) {
        SpanishTechnicalSpeech.prepareForKokoro(conjunction).text
    }
    verify(previousProse == "\ue002El carácter i griega guion bajo el continúa.",
        "The exact previous prose/bookmark contract changed")
    checked(previousProse, "already prepared previous prose")
    verify(SpanishTechnicalSpeech.prepareForKokoro(conjunction).text == "\ue002$conjunction",
        "Previous prose policy leaked into a new plan")

    // The tokenizer remains strict: callers may not bypass normalization with
    // an unspoken number or identifier. The Windows fix belongs before it.
    for (invalid in listOf("7", "nombre_total")) {
        val failure = runCatching { SpanishFluidG2P.phonemizeNormalized(invalid) }.exceptionOrNull()
        verify(failure is IllegalArgumentException &&
            failure.message == "La normalización española dejó un número o identificador sin pronunciar",
            "Unnormalized input bypassed the original tokenizer guard: $invalid")
    }

    val historical = JSONArray(File(args.single()).readText())
    verify(historical.length() == 9, "Missing authentic U12/U11 source field")
    val publications = mutableSetOf<String>()
    for (index in 0 until historical.length()) {
        val item = historical.getJSONObject(index)
        publications += item.getString("publication")
        val modes = item.optJSONArray("modes")?.let { values ->
            (0 until values.length()).map { values.getString(it) }
        } ?: listOf(item.getString("mode"))
        for (mode in modes) {
            val parts = checked(item.getString("source"), item.getString("label") + "/" + mode, mode)
            if (item.has("phoneSha256")) {
                val phones = MixedSpanishG2P.phonemizePrepared(parts[item.getInt("phoneSentence")], emptyMap())
                verify(phoneSha256(phones) == item.getString("phoneSha256"), "The historical criterion's production phonemes changed")
            }
            item.optJSONArray("sentencePhoneSha256")?.let { previous ->
                verify(parts.size == previous.length(), "The historical explanation's sentence boundaries changed")
                parts.forEachIndexed { partIndex, part ->
                    verify(phoneSha256(MixedSpanishG2P.phonemizePrepared(part, emptyMap())) == previous.getString(partIndex),
                        "The historical explanation's production phonemes changed")
                }
            }
        }
    }
    verify(publications.size == 6, "Historical fields do not belong to the six authentic publications")
    println("PASS $assertions assertions, $sentences real frontend sentences, 9 source fields from 6 authenticated publications")
    println("Scope: text preparation, G2P and phone ownership only; no PCM, playback or human listening claim")
}
