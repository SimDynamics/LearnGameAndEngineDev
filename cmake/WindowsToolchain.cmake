# Ninja does not select a Visual C++ environment from the preset's external fields.
# The repository wrapper or Visual Studio supplies the official vcvarsall environment.
if(NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "This base targets native Windows x64.")
endif()

set(_lgaed_toolset "14.51.36231")
set(_lgaed_sdk "10.0.26100.0")
foreach(_lgaed_env VCToolsInstallDir VSINSTALLDIR WindowsSdkDir)
    if(NOT DEFINED ENV{${_lgaed_env}} OR "$ENV{${_lgaed_env}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${_lgaed_env}. Run scripts/windows/Build-Native.ps1 or select the pinned MSVC environment in Visual Studio.")
    endif()
endforeach()

if(NOT "$ENV{VCToolsVersion}" STREQUAL "${_lgaed_toolset}")
    message(FATAL_ERROR "MSVC package ${_lgaed_toolset} is required; selected: '$ENV{VCToolsVersion}'.")
endif()
foreach(_lgaed_arch VSCMD_ARG_HOST_ARCH VSCMD_ARG_TGT_ARCH)
    if(NOT "$ENV{${_lgaed_arch}}" STREQUAL "x64")
        message(FATAL_ERROR "${_lgaed_arch} must be x64; use the repository build wrapper.")
    endif()
endforeach()
string(REGEX REPLACE "[/\\\\]+$" "" _lgaed_selected_sdk "$ENV{WindowsSDKVersion}")
if(NOT _lgaed_selected_sdk STREQUAL _lgaed_sdk OR NOT "$ENV{UCRTVersion}" STREQUAL "${_lgaed_sdk}")
    message(FATAL_ERROR "Windows SDK and UCRT ${_lgaed_sdk} are required; selected SDK '${_lgaed_selected_sdk}', UCRT '$ENV{UCRTVersion}'.")
endif()

file(TO_CMAKE_PATH "$ENV{VCToolsInstallDir}" _lgaed_vc)
file(TO_CMAKE_PATH "$ENV{WindowsSdkDir}" _lgaed_sdk_root)
file(TO_CMAKE_PATH "$ENV{VSINSTALLDIR}" _lgaed_vs)
string(REGEX REPLACE "/+$" "" _lgaed_vc "${_lgaed_vc}")
string(REGEX REPLACE "/+$" "" _lgaed_sdk_root "${_lgaed_sdk_root}")
string(REGEX REPLACE "/+$" "" _lgaed_vs "${_lgaed_vs}")
string(TOLOWER "${_lgaed_vc}" _lgaed_selected_vc)
string(TOLOWER "${_lgaed_vs}/VC/Tools/MSVC/${_lgaed_toolset}" _lgaed_required_vc)
if(NOT _lgaed_selected_vc STREQUAL _lgaed_required_vc)
    message(FATAL_ERROR "VCToolsInstallDir must select ${_lgaed_required_vc}; selected ${_lgaed_vc}.")
endif()

# Check actual include/library search paths too: SDK labels alone are not evidence.
foreach(_lgaed_pair "INCLUDE|Include" "LIB|Lib")
    string(REPLACE "|" ";" _lgaed_parts "${_lgaed_pair}")
    list(GET _lgaed_parts 0 _lgaed_env)
    list(GET _lgaed_parts 1 _lgaed_folder)
    file(TO_CMAKE_PATH "$ENV{${_lgaed_env}}" _lgaed_search_paths)
    string(TOLOWER "${_lgaed_sdk_root}/${_lgaed_folder}/" _lgaed_root_prefix)
    string(TOLOWER "${_lgaed_sdk_root}/${_lgaed_folder}/${_lgaed_sdk}/" _lgaed_expected_prefix)
    set(_lgaed_has_sdk FALSE)
    foreach(_lgaed_path IN LISTS _lgaed_search_paths)
        string(TOLOWER "${_lgaed_path}" _lgaed_lower_path)
        if(_lgaed_lower_path MATCHES "/vc/tools/msvc/([0-9.]+)/")
            if(NOT CMAKE_MATCH_1 STREQUAL _lgaed_toolset)
                message(FATAL_ERROR "${_lgaed_env} mixes another MSVC package: ${_lgaed_path}")
            endif()
        endif()
        string(FIND "${_lgaed_lower_path}" "${_lgaed_root_prefix}" _lgaed_is_sdk)
        if(_lgaed_is_sdk EQUAL 0)
            string(FIND "${_lgaed_lower_path}" "${_lgaed_expected_prefix}" _lgaed_has_version)
            if(NOT _lgaed_has_version EQUAL 0)
                message(FATAL_ERROR "${_lgaed_env} mixes another Windows SDK: ${_lgaed_path}")
            endif()
            set(_lgaed_has_sdk TRUE)
        endif()
    endforeach()
    if(NOT _lgaed_has_sdk)
        message(FATAL_ERROR "${_lgaed_env} does not contain Windows SDK ${_lgaed_sdk} at ${_lgaed_sdk_root}.")
    endif()
endforeach()

foreach(_lgaed_required "include" "lib/x64")
    if(_lgaed_required STREQUAL "include")
        set(_lgaed_env INCLUDE)
    else()
        set(_lgaed_env LIB)
    endif()
    file(TO_CMAKE_PATH "$ENV{${_lgaed_env}}" _lgaed_search_paths)
    string(TOLOWER "${_lgaed_search_paths}" _lgaed_search_paths)
    list(FIND _lgaed_search_paths "${_lgaed_selected_vc}/${_lgaed_required}" _lgaed_required_index)
    if(_lgaed_required_index EQUAL -1)
        message(FATAL_ERROR "${_lgaed_env} must include ${_lgaed_vc}/${_lgaed_required}.")
    endif()
endforeach()

foreach(_lgaed_required "Include/${_lgaed_sdk}/ucrt" "Include/${_lgaed_sdk}/um"
        "Include/${_lgaed_sdk}/shared" "Lib/${_lgaed_sdk}/ucrt/x64" "Lib/${_lgaed_sdk}/um/x64")
    if(_lgaed_required MATCHES "^Include/")
        set(_lgaed_env INCLUDE)
    else()
        set(_lgaed_env LIB)
    endif()
    file(TO_CMAKE_PATH "$ENV{${_lgaed_env}}" _lgaed_search_paths)
    string(TOLOWER "${_lgaed_search_paths}" _lgaed_search_paths)
    string(TOLOWER "${_lgaed_sdk_root}/${_lgaed_required}" _lgaed_full_required)
    list(FIND _lgaed_search_paths "${_lgaed_full_required}" _lgaed_required_index)
    if(_lgaed_required_index EQUAL -1)
        message(FATAL_ERROR "${_lgaed_env} must include ${_lgaed_full_required}.")
    endif()
endforeach()

function(_lgaed_pin_tool variable path)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Required build tool is missing: ${path}")
    endif()
    file(REAL_PATH "${path}" _lgaed_required_path)
    if(DEFINED ${variable} AND NOT "${${variable}}" STREQUAL "")
        # CMake's MSVC try_compile may use the Windows 8.3 spelling of the same
        # installed executable. Resolve filesystem identity before comparing.
        file(REAL_PATH "${${variable}}" _lgaed_existing)
        file(TO_CMAKE_PATH "${_lgaed_existing}" _lgaed_existing)
        string(TOLOWER "${_lgaed_existing}" _lgaed_existing)
        string(TOLOWER "${_lgaed_required_path}" _lgaed_expected)
        if(NOT _lgaed_existing STREQUAL _lgaed_expected)
            message(FATAL_ERROR "${variable} selects '${${variable}}'; required '${path}'. Use a separate preset build tree.")
        endif()
    endif()
    set(${variable} "${_lgaed_required_path}" CACHE FILEPATH "Pinned Windows native build tool" FORCE)
endfunction()

_lgaed_pin_tool(CMAKE_CXX_COMPILER "${_lgaed_vc}/bin/Hostx64/x64/cl.exe")
_lgaed_pin_tool(CMAKE_LINKER "${_lgaed_vc}/bin/Hostx64/x64/link.exe")
_lgaed_pin_tool(CMAKE_RC_COMPILER "${_lgaed_sdk_root}/bin/${_lgaed_sdk}/x64/rc.exe")
_lgaed_pin_tool(CMAKE_MT "${_lgaed_sdk_root}/bin/${_lgaed_sdk}/x64/mt.exe")
_lgaed_pin_tool(CMAKE_MAKE_PROGRAM "${_lgaed_vs}/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe")
