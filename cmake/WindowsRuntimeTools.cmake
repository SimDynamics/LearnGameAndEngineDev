# Shared with the button/build wrapper through toolchains/windows.versions.json.
# Resolve from stable shared installations even when Visual Studio was
# launched before the tools were installed. Never use an Android NDK as a
# substitute for the native Windows SDK, or a JRE as a substitute for JNI.
function(_lgaed_expand_tool_path output value)
    foreach(_name LOCALAPPDATA USERPROFILE ProgramFiles)
        string(REPLACE "%${_name}%" "$ENV{${_name}}" value "${value}")
    endforeach()
    file(TO_CMAKE_PATH "${value}" value)
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

# Java maintenance versions can contain more than four numeric components.
# Keep the release comparison independent of folder names and CMake's VERSION
# operators, which do not represent that complete version format.
function(_lgaed_compare_java_parts left right output)
    list(LENGTH left _left_length)
    list(LENGTH right _right_length)
    set(_length "${_left_length}")
    if(_right_length GREATER _length)
        set(_length "${_right_length}")
    endif()
    set(_comparison 0)
    if(_length GREATER 0)
        math(EXPR _last "${_length} - 1")
        foreach(_index RANGE 0 ${_last})
            set(_left_part 0)
            set(_right_part 0)
            if(_index LESS _left_length)
                list(GET left ${_index} _left_part)
            endif()
            if(_index LESS _right_length)
                list(GET right ${_index} _right_part)
            endif()
            if(_left_part LESS _right_part)
                set(_comparison -1)
                break()
            elseif(_left_part GREATER _right_part)
                set(_comparison 1)
                break()
            endif()
        endforeach()
    endif()
    set(${output} "${_comparison}" PARENT_SCOPE)
endfunction()

function(_lgaed_read_java_candidate root major minimum valid parts build)
    set(${valid} FALSE PARENT_SCOPE)
    foreach(_required bin/java.exe bin/javac.exe bin/jar.exe include/jni.h
            include/win32/jni_md.h bin/server/jvm.dll release)
        if(NOT EXISTS "${root}/${_required}" OR IS_DIRECTORY "${root}/${_required}")
            return()
        endif()
    endforeach()
    file(STRINGS "${root}/release" _release)
    if(NOT "${_release}" MATCHES "(^|;)OS_ARCH=\"(amd64|x86_64|x64)\"(;|$)")
        return()
    endif()
    if("${_release}" MATCHES "(^|;)JAVA_RUNTIME_VERSION=\"([^\"]+)\"(;|$)")
        set(_runtime "${CMAKE_MATCH_2}")
    elseif("${_release}" MATCHES "(^|;)JAVA_VERSION=\"([^\"]+)\"(;|$)")
        set(_runtime "${CMAKE_MATCH_2}")
    else()
        return()
    endif()
    string(TOLOWER "${_runtime}" _runtime_lower)
    if(_runtime_lower MATCHES "(^|[-+.])(ea|beta|rc)[0-9]*([-+.]|$)")
        return()
    endif()
    if(NOT _runtime MATCHES "^([0-9]+(\\.[0-9]+)*)(\\+([0-9]+)(-[A-Za-z0-9.-]+)?)?(-LTS)?$")
        return()
    endif()
    set(_version "${CMAKE_MATCH_1}")
    set(_build "${CMAKE_MATCH_4}")
    if(_build STREQUAL "")
        set(_build 0)
    endif()
    string(REPLACE "." ";" _parts "${_version}")
    list(GET _parts 0 _major)
    if(NOT _major EQUAL major)
        return()
    endif()
    string(REPLACE "." ";" _minimum_parts "${minimum}")
    _lgaed_compare_java_parts("${_parts}" "${_minimum_parts}" _comparison)
    if(_comparison LESS 0)
        return()
    endif()
    set(${parts} "${_parts}" PARENT_SCOPE)
    set(${build} "${_build}" PARENT_SCOPE)
    set(${valid} TRUE PARENT_SCOPE)
endfunction()

function(lgaed_select_windows_runtime_tools)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/toolchains/windows.versions.json")
    file(READ "${CMAKE_SOURCE_DIR}/toolchains/windows.versions.json" _tools)
    string(JSON _python GET "${_tools}" python path)
    _lgaed_expand_tool_path(_python "${_python}")
    if(NOT EXISTS "${_python}")
        message(FATAL_ERROR "Missing Windows Python: ${_python}. Install the version selected by toolchains/windows.versions.json.")
    endif()
    set(Python3_EXECUTABLE "${_python}" CACHE FILEPATH "Windows build Python" FORCE)

    # CTest otherwise caches the first Git inherited from the configuring app.
    string(JSON _git GET "${_tools}" git path)
    string(JSON _git_version GET "${_tools}" git version)
    _lgaed_expand_tool_path(_git "${_git}")
    execute_process(COMMAND "${_git}" --version RESULT_VARIABLE _git_exit
        OUTPUT_VARIABLE _git_output OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _git_exit EQUAL 0 OR NOT _git_output STREQUAL "git version ${_git_version}")
        message(FATAL_ERROR "Required shared Git ${_git_version} is missing: ${_git}")
    endif()
    set(GIT_EXECUTABLE "${_git}" CACHE FILEPATH "Shared Windows Git" FORCE)
    set(GITCOMMAND "${_git}" CACHE FILEPATH "Shared Windows Git for CTest" FORCE)

    string(JSON _vulkan GET "${_tools}" vulkan path)
    _lgaed_expand_tool_path(_vulkan "${_vulkan}")
    foreach(_required Bin/glslc.exe Include/vulkan/vulkan.h Include/vk_video/vulkan_video_codecs_common.h)
        if(NOT EXISTS "${_vulkan}/${_required}")
            message(FATAL_ERROR "Missing native Windows Vulkan SDK component: ${_vulkan}/${_required}")
        endif()
    endforeach()
    set(ENV{VULKAN_SDK} "${_vulkan}")

    string(JSON _pattern GET "${_tools}" java rootPattern)
    string(JSON _java_major GET "${_tools}" java major)
    string(JSON _java_minimum GET "${_tools}" java minVersion)
    _lgaed_expand_tool_path(_pattern "${_pattern}")
    if(NOT "$ENV{LGAED_JAVA_HOME}" STREQUAL "")
        file(TO_CMAKE_PATH "$ENV{LGAED_JAVA_HOME}" _jdk)
        _lgaed_read_java_candidate("${_jdk}" "${_java_major}" "${_java_minimum}"
            _valid _parts _build)
        if(NOT _valid)
            message(FATAL_ERROR "LGAED_JAVA_HOME must select a complete stable Windows x64 JDK ${_java_major}, version ${_java_minimum} or later maintenance: ${_jdk}")
        endif()
    else()
        file(GLOB _jdks LIST_DIRECTORIES TRUE "${_pattern}")
        list(SORT _jdks)
        set(_jdk "")
        set(_best_parts "")
        set(_best_build 0)
        foreach(_candidate IN LISTS _jdks)
            _lgaed_read_java_candidate("${_candidate}" "${_java_major}" "${_java_minimum}"
                _valid _parts _build)
            if(NOT _valid)
                continue()
            endif()
            set(_comparison 1)
            if(NOT _jdk STREQUAL "")
                _lgaed_compare_java_parts("${_parts}" "${_best_parts}" _comparison)
            endif()
            if(_comparison GREATER 0 OR (_comparison EQUAL 0 AND _build GREATER _best_build))
                set(_jdk "${_candidate}")
                set(_best_parts "${_parts}")
                set(_best_build "${_build}")
            endif()
        endforeach()
        if(_jdk STREQUAL "")
            message(FATAL_ERROR "A complete stable Windows x64 JDK ${_java_major}, version ${_java_minimum} or later maintenance, is required in ${_pattern}. Use a complete JDK; the Android Studio JBR lacks JNI headers.")
        endif()
    endif()
    set(LGAED_JAVA_HOME "${_jdk}" CACHE PATH "Complete Windows JNI JDK" FORCE)

    string(JSON _ffmpeg GET "${_tools}" ffmpeg path)
    _lgaed_expand_tool_path(_ffmpeg "${_ffmpeg}")
    if(NOT EXISTS "${_ffmpeg}")
        message(FATAL_ERROR "Missing native Windows FFmpeg: ${_ffmpeg}")
    endif()
    get_filename_component(_ffmpeg_directory "${_ffmpeg}" DIRECTORY)
    execute_process(COMMAND "${_python}" -I -S -B
        "${CMAKE_SOURCE_DIR}/scripts/windows/verify_physical_tools.py"
        "${CMAKE_COMMAND}" "${_python}" "${_git}" "${_vulkan}/Bin/glslc.exe" "${_ffmpeg}"
        "${_jdk}/bin/java.exe" "${_jdk}/include/jni.h" "${_jdk}/bin/server/jvm.dll"
        RESULT_VARIABLE _physical_exit OUTPUT_VARIABLE _physical_output ERROR_VARIABLE _physical_error)
    if(NOT _physical_exit EQUAL 0)
        message(FATAL_ERROR "Windows tools must use physical shared installations: ${_physical_output}${_physical_error}")
    endif()
    set(LGAED_FFMPEG_DIRECTORY "${_ffmpeg_directory}" PARENT_SCOPE)
    set(LGAED_FFMPEG_EXECUTABLE "${_ffmpeg}" PARENT_SCOPE)
    message(STATUS "Windows shared runtime: JDK ${_java_major} at ${_jdk}; Python ${_python}; FFmpeg ${_ffmpeg}")
endfunction()
